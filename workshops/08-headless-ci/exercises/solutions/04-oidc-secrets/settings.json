{
  "apiKeyHelper": "./apiKeyHelper.sh",
  "permissions": {
    "allow": [
      "Read(.)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "WebFetch",
      "Bash(curl *)"
    ],
    "defaultMode": "dontAsk"
  }
}
