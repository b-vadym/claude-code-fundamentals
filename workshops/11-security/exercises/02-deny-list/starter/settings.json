{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(npm test *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "_TODO_": "add rm -rf, sudo, curl, wget, .env, secrets, ~/.aws, ~/.ssh"
    ],
    "ask": [
      "_TODO_": "add git push, npm publish, .github/workflows"
    ],
    "defaultMode": "default"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "filesystem": {
      "denyRead": [
        "_TODO_": "add ~/.aws, ~/.ssh, ./.env*"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/block-dangerous.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
